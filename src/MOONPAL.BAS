10 REM MOONPAL.BAS - lunar scene to compare CGA palettes
20 REM Any key = next palette, ESC = quit
30 DEFINT A-Z: KEY OFF
40 DIM M(5), R(5), N$(5)
50 FOR I = 0 TO 5: READ M(I), R(I), N$(I): NEXT I
60 SCREEN 1, 1: COLOR 0: CLS
70 GOSUB 1000
80 P = 0: GOSUB 2000
90 K$ = INPUT$(1)
100 IF K$ = CHR$(27) THEN SCREEN 0, 0: WIDTH 80: END
110 P = (P + 1) MOD 6: GOSUB 2000: GOTO 90
1000 REM ---- draw scene ----
1010 RANDOMIZE 7
1020 FOR I = 1 TO 70
1030 X = INT(RND * 320): Y = 16 + INT(RND * 110): C = 3
1040 IF RND < .25 THEN C = 1
1050 PSET (X, Y), C: NEXT I
1060 REM earth
1070 CIRCLE (268, 42), 16, 1: PAINT (268, 42), 1, 1
1080 CIRCLE (263, 38), 7, 3, .3, 2.6: CIRCLE (273, 47), 6, 3, 3.5, 5.8
1090 REM terrain
1100 READ OY: OX = 0
1110 FOR X = 20 TO 320 STEP 20
1120 READ Y: X2 = X: IF X2 > 319 THEN X2 = 319
1130 LINE (OX, OY)-(X2, Y), 3: OX = X2: OY = Y: NEXT X
1140 LINE -(319, 199), 3: LINE -(0, 199), 3: READ Y: LINE -(0, Y), 3
1150 PAINT (10, 196), 3, 3
1160 REM craters: outline in 2, dither inside, then rim shading
1170 T$ = CHR$(&HCC) + CHR$(&H33)
1180 FOR I = 1 TO 4
1190 READ X, Y, RR
1200 CIRCLE (X, Y), RR, 2, , , .4: PAINT (X, Y), T$, 2
1210 CIRCLE (X, Y), RR, 0, , , .4: CIRCLE (X, Y), RR, 3, 3.3, 6.1, .4
1220 NEXT I
1230 REM landing pad
1240 LINE (164, 175)-(196, 175), 1: LINE (164, 171)-(164, 175), 1: LINE (196, 171)-(196, 175), 1
1250 REM lander
1260 LINE (175, 84)-(185, 88), 3, BF
1270 LINE (172, 88)-(188, 100), 1, BF: LINE (177, 91)-(183, 95), 0, BF
1280 LINE (170, 100)-(190, 104), 3, BF: LINE (177, 104)-(183, 107), 1, BF
1290 LINE (171, 104)-(165, 112), 1: LINE (189, 104)-(195, 112), 1
1300 LINE (162, 112)-(168, 112), 1: LINE (192, 112)-(198, 112), 1
1310 REM flame
1320 LINE (176, 108)-(180, 123), 2: LINE -(184, 108), 2: LINE -(176, 108), 2
1330 PAINT (180, 111), 2, 2: LINE (180, 109)-(180, 116), 3
1340 REM HUD
1350 LOCATE 1, 1: PRINT "FUEL";: LINE (40, 1)-(100, 5), 1, BF: LINE (39, 0)-(121, 6), 3, B
1360 LOCATE 1, 18: PRINT "ALT 120  VEL -3.2";
1370 RETURN
2000 REM ---- apply palette P ----
2010 OUT &H3D8, M(P): OUT &H3D9, R(P)
2020 LOCATE 25, 1: PRINT LEFT$(N$(P) + SPACE$(39), 39);
2030 RETURN
3000 REM palettes: mode reg, colour reg, name
3010 DATA &H0E,  0, "1/6 CYAN-RED-GREY (burst off)"
3020 DATA &H0E, 16, "2/6 CYAN-RED-WHITE bright"
3030 DATA &H0A, 32, "3/6 CYAN-MAGENTA-GREY"
3040 DATA &H0A, 48, "4/6 CYAN-MAGENTA-WHITE bright"
3050 DATA &H0A,  0, "5/6 GREEN-RED-BROWN"
3060 DATA &H0A, 16, "6/6 GREEN-RED-YELLOW bright"
4000 REM terrain heights, x = 0,20,...,320, then left edge again
4010 DATA 160,155,148,158,170,166,154,162,175,175,175,164,150,140,150,158,166
4020 DATA 160
4030 REM craters x, y, radius
4040 DATA 40,186,12, 105,190,16, 250,188,13, 298,181,8
